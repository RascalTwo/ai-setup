#!/usr/bin/env python3
"""Install the Agent view "agents in this Space" over herdr's socket (agent.view.set).

Run by herdr as this plugin's startup hook; also safe to run by hand. The view is one transient
projection, so setting it replaces whatever view was active.
"""
import json, os, socket, sys

req = {"id": "space-view", "method": "agent.view.set", "params": {
    "source": "plugin:rascaltwo.space-agents",
    "label": "this space",
    "filter": {"op": "eq", "field": "workspace_id", "value": {"context": "current_workspace_id"}},
}}
path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
with socket.socket(socket.AF_UNIX) as s:
    s.settimeout(5)
    s.connect(path)
    s.sendall((json.dumps(req) + "\n").encode())
    reply = b""
    while not reply.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        reply += chunk
result = json.loads(reply or b"{}")
print(json.dumps(result))
sys.exit(0 if result.get("result", {}).get("active") else 1)
