<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  chrome-reaper: every 60 s, kill automation Chromes whose parent died. See ../README.md.
  It runs an installed COPY of reap.sh: launchd may not read ~/Desktop (TCC), where the repo lives.
  Paths are checked in as /Users/YOUR-USER/... — launchd does not expand $HOME. Substitute before installing.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rascaltwo.chrome-reaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/YOUR-USER/.agents/state/chrome-reaper/reap.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR-USER/.agents/state/chrome-reaper/launchd.err</string>
</dict>
</plist>
