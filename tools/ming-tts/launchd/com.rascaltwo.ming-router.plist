<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ming-router: local OpenAI-style TTS endpoint on 127.0.0.1:8895. See ../README.md.
  It runs an installed COPY of router.py: launchd may not read ~/Desktop (TCC), where the repo lives.
  Paths are checked in as /Users/YOUR-USER/... — launchd does not expand $HOME. Substitute before installing.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rascaltwo.ming-router</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/YOUR-USER/.agents/state/ming-tts/router/router.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR-USER/.agents/state/ming-tts/router.log</string>
</dict>
</plist>
