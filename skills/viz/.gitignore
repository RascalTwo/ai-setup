# ADRs. Kept locally for whoever maintains this skill, but intentionally NOT
# committed — they record why decisions were made, not how to run anything.
# SKILL.md is the execution-time manual.
docs/

# Publish/preview build output — generated by viz publish/preview, never source.
.viz-dist/

# viz verify render output — regenerated each run, never source.
.verify/
node_modules/
.mcpb-dist/

# Gemini Gem build output — generated by maintainer/build-gem.ts, never source.
.gem-dist/
