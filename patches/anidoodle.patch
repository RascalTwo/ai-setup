--- a/engine/tools/narrate/providers/r2tts.mjs
+++ b/engine/tools/narrate/providers/r2tts.mjs
@@ -0,0 +1,21 @@
+// r2-tts (Joseph's ai-setup skill): local and offline; picks the voice by who will hear it.
+// "others" (the default) is Joseph's cloned voice, "me" a not-Joseph voice (Harper).
+// voice: { audience: "others", speed: 1, emotion: "happy" }
+// Local edit outside the upstream skill: kept in ai-setup's patches/anidoodle.patch, reapplied by `node install.ts --externals`.
+import { execFileSync } from "node:child_process";
+import { existsSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export const id = "r2tts", cloud = false;
+export const about = "r2-tts (local; Joseph's voice for others, Harper for him)";
+const script = () => process.env.R2TTS ?? join(homedir(), ".agents/skills/r2-tts/r2_tts.py");
+export const available = () => (existsSync(script()) ? { ok: true } : { ok: false, why: `no r2-tts at ${script()} (the r2-tts skill, or set R2TTS)` });
+export const synth = async ({ text, voice = {}, raw }) => {
+  const out = raw + ".wav";
+  const args = ["-B", script(), "say", "--audience", String(voice.audience ?? "others"), "--text", text, "--out", out];
+  if (voice.speed) args.push("--speed", String(voice.speed));
+  if (voice.emotion) args.push("--emotion", String(voice.emotion));
+  execFileSync("python3", args, { stdio: ["ignore", "ignore", "pipe"] });
+  return out;
+};
