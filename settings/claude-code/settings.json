{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__voicemode__converse",
      "mcp__voicemode__service"
    ],
    "deny": [
      "NotebookEdit",
      "AskUserQuestion"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "mcp__voicemode__converse",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/ai-setup/tools/voicemode-hold/transcript.py\" prime",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/ai-setup/tools/ttyimgspool/ttyimgspool-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__voicemode__converse",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/ai-setup/tools/voicemode-hold/transcript.py\" heard",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/ai-setup/tools/ttyimgspool/ttyimgspool-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skills/timeline-studio-tasks/hooks/inflight.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/fleet/hooks/session-state.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/fleet/hooks/session-state.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/dream/hooks/stop.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/ai-setup/tools/herdr-autolabel/herdr-autolabel\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/dream/hooks/session-end.sh\""
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.agents/ai-setup/tools/usage-history/statusline-capture.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "code-modernization@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "dialogExpiry": "10m",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "switchModelsOnFlag": true
}