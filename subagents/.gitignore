# Ruler workspace artifacts we don't use (rules are managed elsewhere)
*.bak
/AGENTS.md
/CLAUDE.md
node_modules/
# NOTE: .claude/agents/ and .codex/agents/ ARE committed on purpose,
# so `install.ts` can symlink them without requiring Ruler at install time.


# START Ruler Generated Files
/.claude/agents
/.codex/agents
/.codex/config.toml
/.codex/config.toml.bak
/AGENTS.md.bak
/CLAUDE.md.bak
# END Ruler Generated Files

# Re-include the compiled reviewers. They are committed on purpose so install.ts
# can symlink them without Ruler. Must sit AFTER the Ruler block (last match
# wins), and .claude needs its own negation because ~/.gitignore ignores
# .claude globally — negating only /.claude/agents recovers 7 of 14 files.
!/.claude/
!/.claude/agents/
!/.codex/agents/
